# QuickPeek frontend environment
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# EXPO_PUBLIC_* vars are bundled into the app — only put publishable (public)
# keys here, never secrets.
#
# NOTE: for device builds (EAS Build / TestFlight), these values are baked in
# at build time from `eas.json` → build profile `env`, NOT from this file.
# This file only affects local `expo start` development.

# Stripe publishable key (safe to embed in the app). Get it from
# https://dashboard.stripe.com → Developers → API keys → "Publishable key"
# (pk_test_... while developing/staging). Free account, test mode is free.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional API base-URL override (the app otherwise derives it from the Metro
# host). Example: http://192.168.1.10:3000
# In device builds this MUST point at the deployed API, e.g.
# https://quickpeek-api.onrender.com — set via eas.json, not here.
# EXPO_PUBLIC_API_URL=
