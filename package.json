{
  "name": "quickpeek_frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bash scripts/start-metro.sh",
    "start:clear": "bash scripts/start-metro.sh --clear",
    "start:tunnel": "bash scripts/start-tunnel.sh",
    "start:tunnel:clear": "bash scripts/start-tunnel.sh --clear",
    "simulator": "bash scripts/run-ios.sh",
    "android": "bash -c 'source scripts/dev-env.sh && exec expo run:android \"$@\"' --",
    "ios": "bash scripts/run-ios.sh",
    "ios:device": "bash scripts/run-ios.sh --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --maxWorkers=2",
    "test:coverage": "jest --coverage --maxWorkers=2"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
